{
  "name": "@whitehash/docs",
  "version": "0.0.4",
  "private": true,
  "description": "Next.js documentation and live component showcases for the whitehash toolkit.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "onchfs:assets": "node scripts/copy-onchfs-worker.mjs",
    "dev": "pnpm onchfs:assets && next dev --webpack",
    "dev:turbo": "pnpm onchfs:assets && next dev",
    "build": "pnpm onchfs:assets && next build",
    "preview": "npx serve out",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@whitehash/chain-reader": "workspace:*",
    "@whitehash/market": "workspace:*",
    "@whitehash/onchfs-sw": "workspace:*",
    "@whitehash/react": "workspace:*",
    "@whitehash/resolve": "workspace:*",
    "@whitehash/runtime": "workspace:*",
    "@whitehash/ui": "workspace:*",
    "geist": "1.7.2",
    "next": "^16.2.10",
    "prism-react-renderer": "^2.4.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
