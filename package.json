{
  "name": "whitehash",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone, self-hostable NFT viewer and preservation toolkit for fxhash generative art — reads directly from public blockchain infrastructure.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm lint && pnpm format && pnpm check-types",
    "check-types": "turbo run check-types",
    "changeset": "changeset",
    "dev": "turbo run dev",
    "fix": "biome check --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "release": "pnpm build && changeset publish",
    "test": "turbo run test",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@changesets/cli": "2.29.8",
    "tsdown": "0.21.10",
    "turbo": "2.5.8",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
