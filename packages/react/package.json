{
  "name": "@whitehash/react",
  "version": "1.0.0",
  "description": "Headless React provider, hooks, and cache adapters for whitehash.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean --deps.never-bundle react",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18.3 <20"
  },
  "dependencies": {
    "@whitehash/chain-reader": "workspace:*",
    "@whitehash/core": "workspace:*",
    "idb-keyval": "6.2.2"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "react": "19.2.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
