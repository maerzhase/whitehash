{
  "name": "@whitehash/onchfs-sw",
  "version": "0.0.2",
  "description": "Resolve onchfs artwork in-browser through a same-origin service worker.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maerzhase/whitehash.git",
    "directory": "packages/onchfs-sw"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker.js": "./dist/worker.js",
    "./onchfs.global.js": "./dist/onchfs.global.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean && tsdown --config tsdown.worker.config.ts && node scripts/prepare-worker.mjs",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@whitehash/core": "workspace:*",
    "onchfs": "0.1.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
