{
  "name": "@whitehash/capture",
  "version": "0.0.1",
  "description": "Framework-neutral fxhash-compatible artwork capture engine for headless Chromium.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./browser/local": {
      "types": "./dist/browser/local.d.ts",
      "import": "./dist/browser/local.js",
      "require": "./dist/browser/local.cjs",
      "default": "./dist/browser/local.js"
    },
    "./browser/remote": {
      "types": "./dist/browser/remote.d.ts",
      "import": "./dist/browser/remote.js",
      "require": "./dist/browser/remote.cjs",
      "default": "./dist/browser/remote.js"
    },
    "./browser/sparticuz": {
      "types": "./dist/browser/sparticuz.d.ts",
      "import": "./dist/browser/sparticuz.js",
      "require": "./dist/browser/sparticuz.cjs",
      "default": "./dist/browser/sparticuz.js"
    },
    "./postprocess": {
      "types": "./dist/postprocess/index.d.ts",
      "import": "./dist/postprocess/index.js",
      "require": "./dist/postprocess/index.cjs",
      "default": "./dist/postprocess/index.js"
    },
    "./store/memory": {
      "types": "./dist/store/memory.d.ts",
      "import": "./dist/store/memory.js",
      "require": "./dist/store/memory.cjs",
      "default": "./dist/store/memory.js"
    },
    "./store/fs": {
      "types": "./dist/store/fs.d.ts",
      "import": "./dist/store/fs.js",
      "require": "./dist/store/fs.cjs",
      "default": "./dist/store/fs.js"
    },
    "./store/s3": {
      "types": "./dist/store/s3.d.ts",
      "import": "./dist/store/s3.js",
      "require": "./dist/store/s3.cjs",
      "default": "./dist/store/s3.js"
    },
    "./store/r2": {
      "types": "./dist/store/r2.d.ts",
      "import": "./dist/store/r2.js",
      "require": "./dist/store/r2.cjs",
      "default": "./dist/store/r2.js"
    },
    "./lock/memory": {
      "types": "./dist/lock/memory.d.ts",
      "import": "./dist/lock/memory.js",
      "require": "./dist/lock/memory.cjs",
      "default": "./dist/lock/memory.js"
    },
    "./lock/redis": {
      "types": "./dist/lock/redis.d.ts",
      "import": "./dist/lock/redis.js",
      "require": "./dist/lock/redis.cjs",
      "default": "./dist/lock/redis.js"
    },
    "./adapters/next": {
      "types": "./dist/adapters/next.d.ts",
      "import": "./dist/adapters/next.js",
      "require": "./dist/adapters/next.cjs",
      "default": "./dist/adapters/next.js"
    },
    "./adapters/hono": {
      "types": "./dist/adapters/hono.d.ts",
      "import": "./dist/adapters/hono.js",
      "require": "./dist/adapters/hono.cjs",
      "default": "./dist/adapters/hono.js"
    },
    "./adapters/express": {
      "types": "./dist/adapters/express.d.ts",
      "import": "./dist/adapters/express.js",
      "require": "./dist/adapters/express.cjs",
      "default": "./dist/adapters/express.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@whitehash/core": "workspace:*"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/browser/{local,remote,sparticuz}.ts src/postprocess/index.ts src/store/{memory,fs,s3,r2}.ts src/lock/{memory,redis}.ts src/adapters/{next,hono,express}.ts --format esm --format cjs --dts --clean --deps.never-bundle puppeteer-core --deps.never-bundle @sparticuz/chromium-min --deps.never-bundle sharp --deps.never-bundle gifenc --deps.never-bundle @aws-sdk/client-s3",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "puppeteer-core": ">=24 <26",
    "@sparticuz/chromium-min": ">=138 <150",
    "sharp": ">=0.33 <0.36",
    "gifenc": "^1.0.3",
    "@aws-sdk/client-s3": ">=3.700 <4"
  },
  "peerDependenciesMeta": {
    "@sparticuz/chromium-min": {
      "optional": true
    },
    "sharp": {
      "optional": true
    },
    "gifenc": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1093.0",
    "@sparticuz/chromium-min": "149.0.0",
    "@types/node": "20.19.0",
    "gifenc": "1.0.3",
    "puppeteer-core": "25.3.0",
    "sharp": "0.35.3",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
