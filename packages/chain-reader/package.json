{
  "name": "@whitehash/chain-reader",
  "version": "0.0.2",
  "description": "Read fxhash wallets and projects from public Tezos, Ethereum, and Base infrastructure.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maerzhase/whitehash.git",
    "directory": "packages/chain-reader"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "snapshots"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "snapshot:update": "tsx scripts/update-snapshot.ts"
  },
  "dependencies": {
    "@whitehash/core": "workspace:*",
    "@whitehash/resolve": "workspace:*",
    "viem": "2.45.0"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
