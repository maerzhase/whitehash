{
  "name": "@whitehash/ui",
  "version": "0.0.1",
  "description": "Complete whitehash React design system: primitives, generative-art compounds, and gallery blocks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maerzhase/whitehash.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./src/theme.css",
    "./source": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./source/*": "./src/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean --deps.never-bundle react --deps.never-bundle react-dom && tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "react": ">=18.3 <20",
    "react-dom": ">=18.3 <20"
  },
  "dependencies": {
    "@whitehash/chain-reader": "workspace:*",
    "@whitehash/core": "workspace:*",
    "@whitehash/react": "workspace:*",
    "@base-ui-components/react": "1.0.0-rc.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
