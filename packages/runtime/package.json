{
  "name": "@whitehash/runtime",
  "version": "0.0.0",
  "description": "Framework-free fxhash artwork runtime controls with an optional React adapter.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maerzhase/whitehash.git",
    "directory": "packages/runtime"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/react/index.ts --format esm --dts --clean --deps.never-bundle react",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18.3 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@whitehash/core": "workspace:*",
    "clsx": "2.1.1",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "react": "19.2.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
