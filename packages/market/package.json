{
  "name": "@whitehash/market",
  "version": "0.0.0",
  "description": "On-demand fxhash market history indexing from public chain infrastructure \u2014 per-project listings, offers, and sales backfill with portable JSON and SQLite artifacts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maerzhase/whitehash.git",
    "directory": "packages/market"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js",
      "default": "./dist/sqlite.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/sqlite.ts --format esm --dts --clean",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsdown src/index.ts src/sqlite.ts --format esm --dts --watch"
  },
  "dependencies": {
    "@whitehash/chain-reader": "workspace:*",
    "@whitehash/core": "workspace:*",
    "sql.js": "1.13.0",
    "viem": "2.45.0"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.11",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
