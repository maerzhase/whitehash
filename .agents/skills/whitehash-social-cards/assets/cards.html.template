<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{{CAMPAIGN_TITLE}}</title>
    <style>
      @font-face{font-family:Geist;src:url("./Geist-Variable.woff2") format("woff2")}
      @font-face{font-family:Mono;src:url("./GeistMono-Variable.woff2") format("woff2")}
      :root{color-scheme:dark;font-family:Geist,Arial,sans-serif;background:#050505;color:#f4e7d8}
      *{box-sizing:border-box}body{width:1280px;height:720px;margin:0;overflow:hidden;background:radial-gradient(ellipse at 82% 8%,#1c201f 0,#0c0d0d 30%,#050505 68%)}
      .card{display:none;width:100%;height:100%;position:relative;padding:48px 66px}.card.active{display:block}
      .card:after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(100deg,rgba(0,0,0,.16),transparent 47%,rgba(255,255,255,.025))}
      .brand{position:absolute;z-index:2;left:66px;top:46px;display:flex;align-items:center;gap:11px;color:#f4e7d8;font-size:17px;font-weight:600;letter-spacing:-.025em}.brand img{width:34px;height:34px;object-fit:contain;border-radius:50%}
      .hero{display:none}.hero.active{display:block}.hero .brand{display:none}.hero-mark{position:absolute;z-index:1;left:140px;top:160px;width:310px;height:310px;object-fit:contain;filter:contrast(1.08) saturate(.78) drop-shadow(0 26px 40px rgba(0,0,0,.62))}.hero-copy{position:absolute;z-index:2;left:560px;top:190px;width:600px}.eyebrow{font:11px Mono,monospace;letter-spacing:.12em;color:#d8d3c9;text-transform:uppercase}.hero-copy h1{margin:20px 0 18px;font-size:60px;line-height:.94;letter-spacing:-4px;font-weight:600}.hero-copy h1 span,.accent{display:block;color:#b5dcd6}.hero-copy p{max-width:520px;margin:0;color:#b8b5af;font-size:18px;line-height:1.4}.hero-footer,footer{position:absolute;z-index:2;left:66px;right:66px;bottom:24px;display:flex;justify-content:space-between;color:#666865;font:11px Mono,monospace}
      .slide-label{position:absolute;z-index:2;right:66px;top:48px;color:#b0b0aa;font:11px Mono,monospace;letter-spacing:.12em}.slide-head{position:relative;z-index:2;margin:68px 0 26px;font-size:50px;line-height:.92;letter-spacing:-3.6px;font-weight:600}.slide-head span{display:block;color:#acd6d0}
      .panel,.terminal,.fact{border:1px solid #303330;border-radius:12px;background:rgba(5,5,5,.72);box-shadow:0 18px 60px rgba(0,0,0,.3)}.terminal{position:relative;z-index:2;padding:24px 28px;font:15px/1.5 Mono,monospace;color:#eee9de}.muted{color:#767a75}.ok{color:#9dcfc9}.blue{color:#9dcfc9}.cream{color:#f4e7d8}
      .api-grid{position:relative;z-index:2;display:grid;grid-template-columns:1.35fr .9fr;gap:18px}.api-grid .panel{min-height:290px;padding:24px 26px;font:14px/1.52 Mono,monospace;color:#ddd9d0;white-space:pre-wrap}.facts{display:grid;gap:10px}.fact{padding:17px 18px}.fact b{display:block;margin-bottom:4px;font-size:15px}.fact span{color:#999c96;font-size:13px;line-height:1.25}
      .outputs-grid{position:relative;z-index:2;display:grid;grid-template-columns:1fr 1fr;gap:18px}.choice{padding:21px;border:1px solid #303330;border-radius:12px;background:rgba(5,5,5,.72);min-height:270px}.choice h2{margin:0 0 12px;font-size:25px;letter-spacing:-1.3px}.choice p{margin:0;color:#999c96;font-size:15px;line-height:1.3}.choice pre{margin:20px 0 0;font:14px/1.4 Mono,monospace;white-space:pre-wrap;color:#eee9de}
    </style>
  </head>
  <body>
    <section class="card hero" data-card="hero">
      <img class="hero-mark" src="./logo-original.png" alt="" />
      <div class="hero-copy"><div class="eyebrow">{{HERO_EYEBROW}}</div><h1>{{HERO_HEADLINE}}<span>{{HERO_ACCENT_LINE}}</span></h1><p>{{HERO_SUBLINE}}</p></div>
      <div class="hero-footer"><span>{{HERO_FOOTER}}</span><span>whitehash.dev</span></div>
    </section>

    <section class="card" data-card="cli">
      <div class="brand"><img src="./logo.png" alt="" />whitehash</div><div class="slide-label">{{CLI_LABEL}}</div>
      <h1 class="slide-head">{{CLI_HEADLINE}}<span>{{CLI_ACCENT_LINE}}</span></h1>
      <div class="terminal"><span class="muted">┌─ {{CLI_TASK}}</span>
│  ❯ {{CLI_COMMAND_LINE_1}}
│    {{CLI_COMMAND_LINE_2}}
│
<span class="ok">└─ ✓ {{CLI_RESULT}}</span></div>
      <footer><span>{{CLI_FOOTER}}</span><span>whitehash.dev</span></footer>
    </section>

    <section class="card" data-card="outputs">
      <div class="brand"><img src="./logo.png" alt="" />whitehash</div><div class="slide-label">{{OUTPUTS_LABEL}}</div>
      <h1 class="slide-head">{{OUTPUTS_HEADLINE}}<span>{{OUTPUTS_ACCENT_LINE}}</span></h1>
      <div class="outputs-grid"><div class="choice"><h2>{{OUTPUT_A_TITLE}}</h2><p>{{OUTPUT_A_DESCRIPTION}}</p><pre>❯ {{OUTPUT_A_COMMAND}}</pre></div><div class="choice"><h2>{{OUTPUT_B_TITLE}}</h2><p>{{OUTPUT_B_DESCRIPTION}}</p><pre>❯ {{OUTPUT_B_COMMAND}}</pre></div></div>
      <footer><span>{{OUTPUTS_FOOTER}}</span><span>whitehash.dev</span></footer>
    </section>

    <section class="card" data-card="api">
      <div class="brand"><img src="./logo.png" alt="" />whitehash</div><div class="slide-label">{{API_LABEL}}</div>
      <h1 class="slide-head">{{API_HEADLINE}}<span>{{API_ACCENT_LINE}}</span></h1>
      <div class="api-grid"><div class="panel">{{API_CODE}}</div><div class="facts"><div class="fact"><b>{{FACT_1_TITLE}}</b><span>{{FACT_1_BODY}}</span></div><div class="fact"><b>{{FACT_2_TITLE}}</b><span>{{FACT_2_BODY}}</span></div><div class="fact"><b>{{FACT_3_TITLE}}</b><span>{{FACT_3_BODY}}</span></div></div></div>
      <footer><span>{{API_FOOTER}}</span><span>whitehash.dev</span></footer>
    </section>

    <script>
      const requested = new URLSearchParams(location.search).get("card") || "hero"
      document.querySelector(`[data-card="${requested}"]`)?.classList.add("active")
    </script>
  </body>
</html>
