<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{{CAMPAIGN_TITLE}}</title>
    <style>
      :root {
        color-scheme: dark;
        font-family:
          Geist, "Helvetica Neue", Arial, ui-sans-serif, system-ui, sans-serif;
        background: #000;
        color: #f4e7d8;
        --canvas: #000;
        --surface: #080808;
        --surface-2: #1a1a1a;
        --line: #ffffff24;
        --line-strong: #ffffff3d;
        --fg: #f4e7d8;
        --muted: #a0a0a0;
        --faint: #777;
        --blue: #47a8ff;
        --success: #00ca50;
      }
      * {
        box-sizing: border-box;
      }
      body {
        width: 1280px;
        height: 720px;
        margin: 0;
        overflow: hidden;
        background: var(--canvas);
      }
      .card {
        position: relative;
        display: none;
        width: 100%;
        height: 100%;
        overflow: hidden;
        padding: 52px 68px;
        background: var(--canvas);
      }
      .card::before {
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1px),
          linear-gradient(90deg, rgb(255 255 255 / 0.07) 1px, transparent 1px);
        background-size: 64px 64px;
        content: "";
        opacity: 0.7;
      }
      .card::after {
        position: absolute;
        width: 620px;
        height: 620px;
        top: 8px;
        right: -36px;
        border-radius: 50%;
        background: radial-gradient(circle, rgb(71 168 255 / 0.18), transparent 68%);
        content: "";
      }
      .card.active {
        display: block;
      }
      .card > * {
        position: relative;
        z-index: 1;
      }
      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 42px;
        color: var(--faint);
        font: 13px/1.2 GeistMono, "SFMono-Regular", Consolas, monospace;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 14px;
        color: var(--fg);
        font: 600 24px/1 Geist, "Helvetica Neue", Arial, sans-serif;
        letter-spacing: -0.6px;
        text-transform: lowercase;
      }
      .brand img {
        width: 42px;
        height: 42px;
        object-fit: contain;
      }
      h1 {
        max-width: 900px;
        margin: 52px 0 30px;
        color: var(--fg);
        font-size: 56px;
        font-weight: 600;
        line-height: 0.99;
        letter-spacing: -3.6px;
      }
      h1 .secondary {
        display: block;
        margin-top: 10px;
        color: var(--faint);
      }
      footer {
        position: absolute !important;
        right: 68px;
        bottom: 32px;
        left: 68px;
        display: flex;
        justify-content: space-between;
        color: var(--faint);
        font-size: 14px;
      }
      .hero-copy {
        position: absolute !important;
        top: 218px;
        left: 68px;
        width: 790px;
      }
      .hero-copy h1 {
        margin: 0;
        font-size: 70px;
        line-height: 0.96;
        letter-spacing: -4.6px;
      }
      .hero-copy h1 span {
        display: block;
      }
      .hero-copy .hero-secondary {
        margin-top: 13px;
        color: var(--faint);
      }
      .hero-copy p {
        max-width: 680px;
        margin: 28px 0 0;
        color: var(--muted);
        font-size: 21px;
        line-height: 1.42;
      }
      .hero-mark {
        position: absolute !important;
        z-index: 1;
        right: -10px;
        bottom: -28px;
        width: 510px;
        height: 510px;
        object-fit: contain;
        filter: drop-shadow(0 30px 70px rgb(0 0 0 / 0.65));
      }
      .hero-card footer span:last-child {
        display: none;
      }
      .terminal,
      .panel {
        overflow: hidden;
        border: 1px solid var(--line-strong);
        border-radius: 12px;
        background: rgb(8 8 8 / 0.94);
        box-shadow: 0 24px 70px rgb(0 0 0 / 0.32);
      }
      pre {
        margin: 0;
        padding: 27px 30px;
        color: var(--fg);
        font: 18px/1.55 GeistMono, "SFMono-Regular", Consolas, monospace;
        white-space: pre-wrap;
      }
      .muted {
        color: var(--faint);
      }
      .ok {
        color: var(--success);
      }
      .focus {
        color: var(--blue);
      }
      .choice-grid,
      .api-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px;
      }
      .choice,
      .fact {
        border: 1px solid var(--line);
        border-radius: 12px;
        background: rgb(8 8 8 / 0.92);
      }
      .choice {
        min-height: 310px;
        padding: 27px;
      }
      .choice-label {
        color: var(--faint);
        font: 12px/1.2 GeistMono, "SFMono-Regular", Consolas, monospace;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }
      .choice h2 {
        margin: 16px 0;
        color: var(--fg);
        font-size: 31px;
        letter-spacing: -1.4px;
      }
      .choice p {
        min-height: 78px;
        margin: 0 0 22px;
        color: var(--muted);
        font-size: 18px;
        line-height: 1.45;
      }
      .choice code {
        display: block;
        padding-top: 20px;
        border-top: 1px solid var(--line);
        color: var(--blue);
        font: 17px/1.5 GeistMono, "SFMono-Regular", Consolas, monospace;
      }
      .api-grid {
        grid-template-columns: 1.18fr 0.82fr;
      }
      .facts {
        display: grid;
        gap: 12px;
      }
      .fact {
        padding: 19px 21px;
      }
      .fact b {
        display: block;
        margin-bottom: 5px;
        color: var(--fg);
        font-size: 17px;
      }
      .fact span {
        color: var(--muted);
        font-size: 15px;
        line-height: 1.4;
      }
    </style>
  </head>
  <body>
    <!-- Keep the hero structure. Remove other cards the campaign does not need. -->
    <section class="card hero-card" data-card="hero">
      <header>
        <div class="brand"><img src="./logo.png" alt="" />whitehash</div>
        <div>{{HERO_LABEL}}</div>
      </header>
      <div class="hero-copy">
        <h1>
          <span>{{HERO_HEADLINE}}</span>
          <span class="hero-secondary">{{HERO_ACCENT_LINE}}</span>
        </h1>
        <p>{{HERO_SUBLINE}}</p>
      </div>
      <img class="hero-mark" src="./logo.png" alt="" />
      <footer><span>{{HERO_FOOTER}}</span><span>whitehash.dev</span></footer>
    </section>

    <section class="card" data-card="cli">
      <header>
        <div class="brand"><img src="./logo.png" alt="" />whitehash</div>
        <div>{{CLI_LABEL}}</div>
      </header>
      <h1>{{CLI_HEADLINE}}<span class="secondary">{{CLI_ACCENT_LINE}}</span></h1>
      <div class="terminal">
        <pre><span class="muted">┌─ {{CLI_TASK}}</span>
│  ❯ <span class="focus">{{CLI_COMMAND_LINE_1}}</span>
│    {{CLI_COMMAND_LINE_2}}
│
<span class="ok">└─ ✓ {{CLI_RESULT}}</span></pre>
      </div>
      <footer><span>{{CLI_FOOTER}}</span><span>whitehash.dev</span></footer>
    </section>

    <section class="card" data-card="outputs">
      <header>
        <div class="brand"><img src="./logo.png" alt="" />whitehash</div>
        <div>{{OUTPUTS_LABEL}}</div>
      </header>
      <h1>{{OUTPUTS_HEADLINE}}<span class="secondary">{{OUTPUTS_ACCENT_LINE}}</span></h1>
      <div class="choice-grid">
        <div class="choice">
          <div class="choice-label">{{OUTPUT_A_LABEL}}</div>
          <h2>{{OUTPUT_A_TITLE}}</h2>
          <p>{{OUTPUT_A_DESCRIPTION}}</p>
          <code>❯ {{OUTPUT_A_COMMAND}}</code>
        </div>
        <div class="choice">
          <div class="choice-label">{{OUTPUT_B_LABEL}}</div>
          <h2>{{OUTPUT_B_TITLE}}</h2>
          <p>{{OUTPUT_B_DESCRIPTION}}</p>
          <code>❯ {{OUTPUT_B_COMMAND}}</code>
        </div>
      </div>
      <footer><span>{{OUTPUTS_FOOTER}}</span><span>whitehash.dev</span></footer>
    </section>

    <section class="card" data-card="api">
      <header>
        <div class="brand"><img src="./logo.png" alt="" />whitehash</div>
        <div>{{API_LABEL}}</div>
      </header>
      <h1>{{API_HEADLINE}}<span class="secondary">{{API_ACCENT_LINE}}</span></h1>
      <div class="api-grid">
        <div class="panel"><pre>{{API_CODE}}</pre></div>
        <div class="facts">
          <div class="fact"><b>{{FACT_1_TITLE}}</b><span>{{FACT_1_BODY}}</span></div>
          <div class="fact"><b>{{FACT_2_TITLE}}</b><span>{{FACT_2_BODY}}</span></div>
          <div class="fact"><b>{{FACT_3_TITLE}}</b><span>{{FACT_3_BODY}}</span></div>
        </div>
      </div>
      <footer><span>{{API_FOOTER}}</span><span>whitehash.dev</span></footer>
    </section>

    <script>
      const requested = new URLSearchParams(location.search).get("card") || "hero"
      document.querySelector(`[data-card="${requested}"]`)?.classList.add("active")
    </script>
  </body>
</html>
